        "y": 1,
        "outgoingEdgeIDs": []
      },
      {
        "id": "downstream_switch",
        "x": 2,
        "y": -1,
        "outgoingEdgeIDs": [
          "e_d0",
          "e_d1"
        ]
      },
      {
        "id": "downstream_dead",
