{
  "schemaVersion": 3,
  "rules": {
    "switchInteractionMode": "liveLookahead",
    "switchLookaheadSeconds": 1.35,
    "switchTapCooldownSeconds": 0.12
  },
  "id": "objective_road_state_progression",
  "name": "Objective Road State Progression",
  "graph": {
    "nodes": [
      {"id": "start", "x": 0.0, "y": 0.0, "outgoingEdgeIDs": ["e_start_hub"]},
      {"id": "hub", "x": 0.6, "y": 0.0, "outgoingEdgeIDs": ["e_hub_pickup", "e_hub_checkpoint", "e_hub_destination"]},
      {"id": "pickup", "x": 1.2, "y": 0.0, "outgoingEdgeIDs": ["e_pickup_hub"]},
      {"id": "checkpoint", "x": 0.6, "y": 0.6, "outgoingEdgeIDs": ["e_checkpoint_hub"]},
      {"id": "destination", "x": 0.6, "y": -0.6, "outgoingEdgeIDs": []}
    ],
    "edges": [
      {"id": "e_start_hub", "fromNodeID": "start", "toNodeID": "hub", "roadShape": "horizontalFirst"},
      {
        "id": "e_hub_pickup",
        "fromNodeID": "hub",
        "toNodeID": "pickup",
        "roadShape": "horizontalFirst",
        "availabilityRule": {"maximumObjectiveIndex": 0, "usageLimit": 1}
      },
      {
        "id": "e_hub_checkpoint",
        "fromNodeID": "hub",
        "toNodeID": "checkpoint",
        "roadShape": "verticalFirst",
        "availabilityRule": {
          "requiredCompletedObjectiveIDs": ["collect"],
          "minimumObjectiveIndex": 1,
          "maximumObjectiveIndex": 1
        }
      },
      {
        "id": "e_hub_destination",
        "fromNodeID": "hub",
        "toNodeID": "destination",
        "roadShape": "verticalFirst",
        "availabilityRule": {
          "requiredCompletedObjectiveIDs": ["collect", "inspect"],
          "minimumObjectiveIndex": 2
        }
      },
      {"id": "e_pickup_hub", "fromNodeID": "pickup", "toNodeID": "hub", "roadShape": "horizontalFirst"},
      {"id": "e_checkpoint_hub", "fromNodeID": "checkpoint", "toNodeID": "hub", "roadShape": "verticalFirst"}
    ]
  },
  "startNodeID": "start",
  "packageNodeID": "pickup",
  "destinationNodeID": "destination",
  "timeLimitSeconds": 12,
  "parTaps": 0,
  "objectives": [
    {
      "id": "collect",
      "nodeID": "pickup",
      "kind": "pickup",
      "sequenceIndex": 0,
      "revealPolicy": "always",
      "displayMetadata": {"title": "Collect the parcel"}
    },
    {
      "id": "inspect",
      "nodeID": "checkpoint",
      "kind": "checkpoint",
      "sequenceIndex": 1,
      "revealPolicy": "whenActive",
      "displayMetadata": {"title": "Visit the checkpoint"}
    },
    {
      "id": "finish",
      "nodeID": "destination",
      "kind": "destination",
      "sequenceIndex": 2,
      "revealPolicy": "whenActive",
      "displayMetadata": {"title": "Reach the destination"}
    }
  ]
}
