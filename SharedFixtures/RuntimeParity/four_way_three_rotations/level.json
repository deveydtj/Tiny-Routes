{
  "schemaVersion": 2,
  "id": "parity_four_way_three_rotations",
  "name": "four way three rotations",
  "graph": {
    "nodes": [
      {
        "id": "start",
        "x": 0,
        "y": 0,
        "outgoingEdgeIDs": [
          "e_start"
        ]
      },
      {
        "id": "switch",
        "x": 1,
        "y": 0,
        "outgoingEdgeIDs": [
          "e_switch_0",
          "e_switch_1",
          "e_switch_2",
          "e_switch_3"
        ]
      },
      {
        "id": "package",
        "x": 2,
        "y": 0,
        "outgoingEdgeIDs": [
          "e_package_destination"
        ]
      },
      {
        "id": "destination",
        "x": 3,
        "y": 0,
        "outgoingEdgeIDs": []
      },
      {
        "id": "branch_0",
        "x": 2,
        "y": 1,
        "outgoingEdgeIDs": []
      },
      {
        "id": "branch_1",
        "x": 2,
        "y": 2,
        "outgoingEdgeIDs": []
      },
      {
        "id": "branch_2",
        "x": 2,
        "y": 3,
        "outgoingEdgeIDs": []
      }
    ],
    "edges": [
      {
        "id": "e_start",
        "fromNodeID": "start",
        "toNodeID": "switch",
        "roadShape": "straight"
      },
      {
        "id": "e_switch_0",
        "fromNodeID": "switch",
        "toNodeID": "branch_0",
        "roadShape": "straight"
      },
      {
        "id": "e_switch_1",
        "fromNodeID": "switch",
        "toNodeID": "branch_1",
        "roadShape": "straight"
      },
      {
        "id": "e_switch_2",
        "fromNodeID": "switch",
        "toNodeID": "branch_2",
        "roadShape": "straight"
      },
      {
        "id": "e_switch_3",
        "fromNodeID": "switch",
        "toNodeID": "package",
        "roadShape": "straight"
      },
      {
        "id": "e_package_destination",
        "fromNodeID": "package",
        "toNodeID": "destination",
        "roadShape": "straight"
      }
    ]
  },
  "startNodeID": "start",
  "packageNodeID": "package",
  "destinationNodeID": "destination",
  "timeLimitSeconds": 12,
  "parTaps": 3,
  "rules": {
    "switchInteractionMode": "liveLookahead",
    "switchLookaheadSeconds": 1.35,
    "switchTapCooldownSeconds": 0.12
  }
}
